  "dependencies": {
    "archiver": "^7.0.1",
    "async": "^3.2.6",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "child_process": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "joi": "^18.1.2",
    "json-bigint": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "os": "^0.1.2",
    "pdf-parse": "^1.1.1",
    "pdf-parser": "^1.0.5",
    "python-shell": "^5.0.0",
